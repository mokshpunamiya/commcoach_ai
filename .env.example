# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Required ─────────────────────────────────────────
# Your Sarvam AI API key (https://dashboard.sarvam.ai/)
SARVAM_API_KEY=your-sarvam-api-key-here

# ─── Optional overrides ───────────────────────────────
# Sarvam chat model to use (default: sarvam-105b)
# Valid values: sarvam-105b, sarvam-105b-conversations
# SARVAM_MODEL=sarvam-105b

# Sarvam STT model to use (default: saaras:v3)
# Valid values: saaras:v3, saaras:v4, saarika:v2.5, saarika:v2, saarika:flash
# SARVAM_STT_MODEL=saaras:v3

# LLM provider: sarvam (default) | openai
# LLM_PROVIDER=sarvam

# OpenAI fallback (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# API server bind address (default: 127.0.0.1)
# API_HOST=127.0.0.1

# API server port (default: 8000)
# API_PORT=8000
