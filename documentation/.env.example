# CommCoach AI -- environment variable template
# Copy this file to .env (or set these as real environment variables) and fill in your values.
#
# Note: the Streamlit backend also supports .streamlit/secrets.toml -- see
# .streamlit/secrets.toml.example in the backend/ folder. sarvam_client.get_api_key()
# checks the environment first, so a plain .env loaded via python-dotenv (or your
# shell/CI config) works too.

# ---------------------------------------------------------------------------
# Required for LIVE mode. Without this, the app runs automatically in demo
# mode with realistic mock data -- every feature still works end-to-end.
# Get a key at https://dashboard.sarvam.ai/
# ---------------------------------------------------------------------------
SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# Optional -- Streamlit server settings, only needed if you want to override
# the defaults (e.g. running behind a reverse proxy or on a fixed port).
# ---------------------------------------------------------------------------
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
